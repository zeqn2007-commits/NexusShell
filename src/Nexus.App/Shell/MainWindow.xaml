<Window
    x:Class="Nexus.App.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:Nexus.App.Shell"
    xmlns:ui="using:Nexus.App.Converters"
    Title="Nexus">

    <Grid x:Name="RootGrid" PointerPressed="RootGrid_PointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="T" Invoked="NewTabAccelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="W" Invoked="CloseTabAccelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Tab" Invoked="NextTabAccelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Tab" Invoked="PreviousTabAccelerator_Invoked" Modifiers="Control,Shift" />
            <KeyboardAccelerator Key="Left" Invoked="BackAccelerator_Invoked" Modifiers="Menu" />
            <KeyboardAccelerator Key="Right" Invoked="ForwardAccelerator_Invoked" Modifiers="Menu" />
            <KeyboardAccelerator Key="Up" Invoked="UpAccelerator_Invoked" Modifiers="Menu" />
            <KeyboardAccelerator Key="F" Invoked="SearchAccelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="E" Invoked="SearchAccelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="L" Invoked="AddressAccelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="D" Invoked="AddressAccelerator_Invoked" Modifiers="Menu" />
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!--  Title bar: tabs on Mica, exactly where Windows 11 Explorer puts them  -->
        <TabView
            x:Name="TabStrip"
            Grid.Row="0"
            VerticalAlignment="Bottom"
            AddTabButtonCommand="{x:Bind ViewModel.NewTabCommand}"
            CanDragTabs="False"
            CanReorderTabs="True"
            IsAddTabButtonVisible="True"
            SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=TwoWay}"
            TabCloseRequested="TabStrip_TabCloseRequested"
            TabItemsSource="{x:Bind ViewModel.Tabs}"
            TabWidthMode="Equal">
            <TabView.Resources>
                <x:Double x:Key="TabViewItemMaxWidth">240</x:Double>
            </TabView.Resources>
            <TabView.TabStripHeader>
                <Grid Padding="14,0,6,0" VerticalAlignment="Center">
                    <Image
                        Width="18"
                        Height="18"
                        AutomationProperties.Name="Nexus"
                        Source="ms-appx:///Assets/AppIcon.png" />
                </Grid>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="DragRegion" MinWidth="188" Background="Transparent" />
            </TabView.TabStripFooter>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="shell:TabViewModel">
                    <TabViewItem
                        Header="{x:Bind Title, Mode=OneWay}"
                        IconSource="{x:Bind ui:Ui.GlyphIcon(Glyph), Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!--  Toolbar: navigation, address and search share one row  -->
        <Grid
            Grid.Row="1"
            Height="{StaticResource NxToolbarHeight}"
            Padding="8,0,12,0"
            Background="{ThemeResource NxChromeBackgroundBrush}"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="Назад"
                    Command="{x:Bind ViewModel.GoBackCommand}"
                    IsEnabled="{x:Bind ViewModel.SelectedTab.CanGoBack, Mode=OneWay, FallbackValue=False}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Назад (Alt+←)">
                    <FontIcon FontSize="16" Glyph="&#xE72B;" />
                </Button>
                <Button
                    AutomationProperties.Name="Вперёд"
                    Command="{x:Bind ViewModel.GoForwardCommand}"
                    IsEnabled="{x:Bind ViewModel.SelectedTab.CanGoForward, Mode=OneWay, FallbackValue=False}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Вперёд (Alt+→)">
                    <FontIcon FontSize="16" Glyph="&#xE72A;" />
                </Button>
                <Button
                    AutomationProperties.Name="На уровень вверх"
                    Command="{x:Bind ViewModel.GoUpCommand}"
                    IsEnabled="{x:Bind ViewModel.SelectedTab.CanGoUp, Mode=OneWay, FallbackValue=False}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Вверх (Alt+↑)">
                    <FontIcon FontSize="16" Glyph="&#xE74A;" />
                </Button>
                <Button
                    AutomationProperties.Name="Обновить"
                    Click="Refresh_Click"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Обновить (F5)">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </StackPanel>

            <Border
                x:Name="AddressBorder"
                Grid.Column="1"
                Height="34"
                VerticalAlignment="Center"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Tapped="AddressBorder_Tapped">
                <Grid>
                    <Grid
                        x:Name="BreadcrumbHost"
                        Padding="10,0,4,0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="{x:Bind ViewModel.SelectedTab.Glyph, Mode=OneWay, FallbackValue=''}" />
                        <BreadcrumbBar
                            x:Name="Breadcrumb"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            ItemClicked="Breadcrumb_ItemClicked"
                            ItemsSource="{x:Bind ViewModel.SelectedTab.Breadcrumb, Mode=OneWay}" />
                    </Grid>
                    <TextBox
                        x:Name="AddressBox"
                        VerticalAlignment="Stretch"
                        AutomationProperties.Name="Адрес"
                        BorderThickness="0"
                        KeyDown="AddressBox_KeyDown"
                        LostFocus="AddressBox_LostFocus"
                        PlaceholderText="Введите путь к папке или файлу"
                        Visibility="Collapsed">
                        <TextBox.Resources>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                </Grid>
            </Border>

            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Column="2"
                Width="320"
                VerticalAlignment="Center"
                AutomationProperties.Name="Поиск"
                IsEnabled="{x:Bind IsSearchAvailable, Mode=OneWay}"
                PlaceholderText="{x:Bind ViewModel.SelectedTab.SearchPlaceholder, Mode=OneWay, FallbackValue='Поиск'}"
                PreviewKeyDown="SearchBox_PreviewKeyDown"
                QueryIcon="Find"
                QuerySubmitted="SearchBox_QuerySubmitted"
                TextChanged="SearchBox_TextChanged" />
        </Grid>

        <Rectangle
            Grid.Row="1"
            VerticalAlignment="Bottom"
            Style="{StaticResource NxDividerStyle}" />

        <!--  Workspace: navigation pane + page  -->
        <NavigationView
            x:Name="Sidebar"
            Grid.Row="2"
            Background="{ThemeResource NxWorkspaceBackgroundBrush}"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="Sidebar_ItemInvoked"
            OpenPaneLength="252"
            PaneDisplayMode="Left">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Transparent" />
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
                <Thickness x:Key="NavigationViewItemInnerHeaderMargin">16,12,0,4</Thickness>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Главная" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Недавние" Tag="recent">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Избранное" Tag="favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE734;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader x:Name="FoldersHeader" Content="Папки" />

                <NavigationViewItemHeader Content="Библиотеки" />
                <NavigationViewItem Content="Приложения" Tag="apps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Игры" Tag="games">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7FC;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI-центр" Tag="ai">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE794;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Торренты" Tag="torrents">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F7;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemHeader Content="Устройства" />
                <NavigationViewItem x:Name="ThisPcItem" Content="Этот компьютер" Tag="thispc">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Сеть" Tag="network">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEC27;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--  Selected when the current location has no sidebar entry (NavigationView keeps a stale indicator on null).  -->
                <NavigationViewItem
                    x:Name="NoSelectionItem"
                    Height="0"
                    MinHeight="0"
                    Margin="0"
                    Padding="0"
                    AutomationProperties.AccessibilityView="Raw"
                    IsHitTestVisible="False"
                    IsTabStop="False"
                    Opacity="0" />
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Корзина" Tag="recycle">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Настройки" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />

                <!--  Floating notification: never shifts the page under the pointer  -->
                <Border
                    x:Name="NotificationHost"
                    MinWidth="360"
                    MaxWidth="640"
                    Margin="24,0,24,20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <InfoBar
                        x:Name="Notification"
                        Margin="-1"
                        CloseButtonClick="Notification_CloseButtonClick"
                        IsOpen="False">
                        <InfoBar.ActionButton>
                            <Button x:Name="NotificationAction" Click="NotificationAction_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </Border>
            </Grid>
        </NavigationView>

        <!--  Status bar  -->
        <Grid
            Grid.Row="3"
            Height="{StaticResource NxStatusBarHeight}"
            Padding="16,0,8,0"
            Background="{ThemeResource NxWorkspaceBackgroundBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource NxSecondaryTextStyle}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource NxSecondaryTextStyle}"
                Text="{x:Bind ViewModel.SelectionText, Mode=OneWay}" />
        </Grid>
    </Grid>
</Window>
