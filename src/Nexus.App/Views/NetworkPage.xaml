<Page
    x:Class="Nexus.App.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexus.App.Controls"
    xmlns:ui="using:Nexus.App.Converters"
    xmlns:vm="using:Nexus.App.ViewModels"
    Background="Transparent">

    <Page.Resources>
        <DataTemplate x:Key="NetworkTileTemplate" x:DataType="vm:NetworkTile">
            <Button
                Padding="12,10"
                AutomationProperties.Name="{x:Bind Name}"
                Click="Tile_Click"
                Style="{StaticResource NxCardButtonStyle}"
                Tag="{x:Bind}"
                ToolTipService.ToolTip="{x:Bind Target}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:FileIcon
                        VerticalAlignment="Center"
                        IconSize="40"
                        Kind="{x:Bind Kind}"
                        ShowTile="True" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="1">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource NxItemTitleTextStyle}"
                            Text="{x:Bind Name}" />
                        <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="{x:Bind Subtitle}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1480"
            Padding="{StaticResource NxPagePadding}"
            Spacing="28">

            <StackPanel Spacing="2">
                <TextBlock Style="{StaticResource NxPageTitleStyle}" Text="Сеть" />
                <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="Компьютеры и устройства в вашей локальной сети" />
            </StackPanel>

            <!--  Computers  -->
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="Компьютеры" />
                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}">
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="Поиск в сети…" />
                    </StackPanel>
                </Grid>
                <ItemsRepeater ItemTemplate="{StaticResource NetworkTileTemplate}" ItemsSource="{x:Bind ViewModel.Computers}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemHeight="68"
                            MinItemWidth="280"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <!--  Nothing found: usually network discovery is off  -->
                <Border Style="{StaticResource NxCardStyle}" Visibility="{x:Bind ui:Ui.Visible(ViewModel.NoComputersFound), Mode=OneWay}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="24"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE977;" />
                        <StackPanel
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock FontWeight="SemiBold" Text="Компьютеры не найдены" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Возможно, выключено сетевое обнаружение. Включите его в параметрах общего доступа или введите \\имя-компьютера в адресной строке."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Click="SharingSettings_Click"
                            Content="Параметры общего доступа" />
                    </Grid>
                </Border>
            </StackPanel>

            <!--  Media servers, printers, routers  -->
            <StackPanel Spacing="12" Visibility="{x:Bind ui:Ui.Visible(ViewModel.HasDevices), Mode=OneWay}">
                <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="Устройства" />
                <ItemsRepeater ItemTemplate="{StaticResource NetworkTileTemplate}" ItemsSource="{x:Bind ViewModel.Devices}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemHeight="68"
                            MinItemWidth="280"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!--  Mapped drives and saved network locations  -->
            <StackPanel Spacing="12" Visibility="{x:Bind ui:Ui.Visible(ViewModel.HasLocations), Mode=OneWay}">
                <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="Сетевые расположения" />
                <ItemsRepeater ItemTemplate="{StaticResource NetworkTileTemplate}" ItemsSource="{x:Bind ViewModel.Locations}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="8"
                            MinItemHeight="68"
                            MinItemWidth="280"
                            MinRowSpacing="8" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
