<Page
    x:Class="Nexus.App.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexus.App.Controls"
    xmlns:ui="using:Nexus.App.Converters"
    xmlns:vm="using:Nexus.App.ViewModels"
    Background="Transparent">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1480"
            Padding="{StaticResource NxPagePadding}"
            Spacing="24">

            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource NxPageTitleStyle}" Text="Приложения" />
                    <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                </StackPanel>
                <ProgressRing
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            </Grid>

            <!--  Letters with app tiles, as in Start's "All apps"  -->
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="20" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppGroup">
                        <StackPanel Spacing="8">
                            <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="{x:Bind Letter}" />
                            <ItemsRepeater ElementPrepared="Apps_ElementPrepared" ItemsSource="{x:Bind Apps}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout
                                        ItemsStretch="Fill"
                                        MinColumnSpacing="8"
                                        MinItemHeight="56"
                                        MinItemWidth="248"
                                        MinRowSpacing="8" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppItemViewModel">
                                        <Button
                                            Padding="12,8"
                                            AutomationProperties.Name="{x:Bind Name}"
                                            Click="App_Click"
                                            ContextRequested="App_ContextRequested"
                                            Style="{StaticResource NxCardButtonStyle}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="{x:Bind Name}">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:FileIcon
                                                    VerticalAlignment="Center"
                                                    IconSize="32"
                                                    Kind="Application"
                                                    ShowTile="True"
                                                    Visibility="{x:Bind ui:Ui.Collapsed(HasIcon), Mode=OneWay}" />
                                                <Image
                                                    Width="32"
                                                    Height="32"
                                                    VerticalAlignment="Center"
                                                    Source="{x:Bind Icon, Mode=OneWay}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource NxItemTitleTextStyle}"
                                                    Text="{x:Bind Name}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <StackPanel
                Margin="0,48,0,0"
                HorizontalAlignment="Center"
                Spacing="8"
                Visibility="{x:Bind ui:Ui.Visible(ViewModel.NothingFound), Mode=OneWay}">
                <FontIcon
                    FontSize="48"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Glyph="&#xE721;" />
                <TextBlock
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Ничего не найдено" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Попробуйте другое название приложения." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
