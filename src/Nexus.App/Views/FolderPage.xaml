<Page
    x:Class="Nexus.App.Views.FolderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexus.App.Controls"
    xmlns:ui="using:Nexus.App.Converters"
    xmlns:vm="using:Nexus.App.ViewModels"
    AllowDrop="True"
    Background="Transparent"
    DragEnter="Page_DragEnter"
    DragOver="Page_DragOver"
    Drop="Page_Drop"
    KeyDown="Page_KeyDown">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1200" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!--  On a narrow window the details pane closes first, as in Explorer.  -->
                        <Setter Target="DetailsPaneHost.Visibility" Value="Collapsed" />
                        <Setter Target="DetailsToggleLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SortLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ViewLabel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!--  Command bar (Explorer order)  -->
        <Grid Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="Создать"
                    IsEnabled="{x:Bind ViewModel.IsPhysicalFolder, Mode=OneWay}"
                    Style="{StaticResource NxCommandTextButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE710;" />
                        <TextBlock Text="Создать" />
                        <FontIcon
                            Margin="0,2,0,0"
                            FontSize="10"
                            Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem
                                Click="NewFolder_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+Shift+N"
                                Text="Папку">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="NewTextFile_Click" Text="Текстовый документ">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7C3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Rectangle Style="{StaticResource NxVerticalDividerStyle}" />

                <Button
                    AutomationProperties.Name="Вырезать"
                    Click="Cut_Click"
                    IsEnabled="{x:Bind CanModifySelection, Mode=OneWay}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Вырезать (Ctrl+X)">
                    <FontIcon FontSize="16" Glyph="&#xE8C6;" />
                </Button>
                <Button
                    AutomationProperties.Name="Копировать"
                    Click="Copy_Click"
                    IsEnabled="{x:Bind CanModifySelection, Mode=OneWay}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Копировать (Ctrl+C)">
                    <FontIcon FontSize="16" Glyph="&#xE8C8;" />
                </Button>
                <Button
                    x:Name="PasteButton"
                    AutomationProperties.Name="Вставить"
                    Click="Paste_Click"
                    IsEnabled="{x:Bind ViewModel.IsPhysicalFolder, Mode=OneWay}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Вставить (Ctrl+V)">
                    <FontIcon FontSize="16" Glyph="&#xE77F;" />
                </Button>
                <Button
                    AutomationProperties.Name="Переименовать"
                    Click="Rename_Click"
                    IsEnabled="{x:Bind CanModifySelection, Mode=OneWay}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Переименовать (F2)">
                    <FontIcon FontSize="16" Glyph="&#xE8AC;" />
                </Button>
                <Button
                    AutomationProperties.Name="Копировать путь"
                    Click="CopyPath_Click"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Копировать путь (Ctrl+Shift+C)">
                    <FontIcon FontSize="16" Glyph="&#xE71B;" />
                </Button>
                <Button
                    AutomationProperties.Name="Удалить"
                    Click="Delete_Click"
                    IsEnabled="{x:Bind CanModifySelection, Mode=OneWay}"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Удалить в Корзину (Delete)">
                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                </Button>

                <Rectangle Style="{StaticResource NxVerticalDividerStyle}" />

                <Button AutomationProperties.Name="Сортировать" Style="{StaticResource NxCommandTextButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8CB;" />
                        <TextBlock x:Name="SortLabel" Text="Сортировать" />
                        <FontIcon
                            Margin="0,2,0,0"
                            FontSize="10"
                            Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" Placement="BottomEdgeAlignedLeft">
                            <RadioMenuFlyoutItem x:Name="SortByName" Click="SortField_Click" GroupName="SortField" Tag="Name" Text="Имя" />
                            <RadioMenuFlyoutItem x:Name="SortByModified" Click="SortField_Click" GroupName="SortField" Tag="Modified" Text="Дата изменения" />
                            <RadioMenuFlyoutItem x:Name="SortByType" Click="SortField_Click" GroupName="SortField" Tag="Type" Text="Тип" />
                            <RadioMenuFlyoutItem x:Name="SortBySize" Click="SortField_Click" GroupName="SortField" Tag="Size" Text="Размер" />
                            <MenuFlyoutSeparator />
                            <RadioMenuFlyoutItem x:Name="SortAscending" Click="SortDirection_Click" GroupName="SortOrder" Tag="Ascending" Text="По возрастанию" />
                            <RadioMenuFlyoutItem x:Name="SortDescending" Click="SortDirection_Click" GroupName="SortOrder" Tag="Descending" Text="По убыванию" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button AutomationProperties.Name="Просмотреть" Style="{StaticResource NxCommandTextButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                        <TextBlock x:Name="ViewLabel" Text="Просмотреть" />
                        <FontIcon
                            Margin="0,2,0,0"
                            FontSize="10"
                            Glyph="&#xE70D;" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout x:Name="ViewMenu" Opening="ViewMenu_Opening" Placement="BottomEdgeAlignedLeft">
                            <RadioMenuFlyoutItem x:Name="ViewTiles" Click="ViewMode_Click" GroupName="ViewMode" Tag="Tiles" Text="Крупные значки">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE80A;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <RadioMenuFlyoutItem x:Name="ViewDetails" Click="ViewMode_Click" GroupName="ViewMode" Tag="Details" Text="Таблица">
                                <RadioMenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8FD;" />
                                </RadioMenuFlyoutItem.Icon>
                            </RadioMenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem x:Name="ShowHiddenToggle" Click="ShowHidden_Click" Text="Скрытые элементы" />
                            <ToggleMenuFlyoutItem x:Name="ShowExtensionsToggle" Click="ShowExtensions_Click" Text="Расширения имён файлов" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.Name="Другие команды"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Другие команды">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuFlyoutItem Click="SelectAll_Click" KeyboardAcceleratorTextOverride="Ctrl+A" Text="Выделить всё">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="Undo_Click" KeyboardAcceleratorTextOverride="Ctrl+Z" Text="Отменить последнее действие">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="PinFolder_Click" Text="Закрепить на панели быстрого доступа">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE718;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="Terminal_Click" Text="Открыть в терминале">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE756;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Click="Explorer_Click" Text="Открыть в Проводнике">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xEC50;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="Properties_Click" KeyboardAcceleratorTextOverride="Alt+Enter" Text="Свойства">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Button
                Grid.Column="1"
                Margin="0,0,4,0"
                AutomationProperties.Name="Разобрать «Загрузки»"
                Click="Organize_Click"
                Style="{StaticResource NxCommandTextButtonStyle}"
                ToolTipService.ToolTip="Что можно удалить и как разложить скачанное по папкам"
                Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsDownloads), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="&#xE8F1;" />
                    <TextBlock Text="Разобрать" />
                </StackPanel>
            </Button>
            <ToggleButton
                Grid.Column="2"
                Height="36"
                Padding="10,0"
                VerticalAlignment="Center"
                AutomationProperties.Name="Сведения"
                Background="Transparent"
                BorderThickness="0"
                IsChecked="{x:Bind ViewModel.IsDetailsPaneOpen, Mode=TwoWay}"
                ToolTipService.ToolTip="Панель сведений">
                <ToggleButton.Resources>
                    <!--  Explorer-style toggle: a quiet highlight instead of an accent fill  -->
                    <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                    <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                    <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                </ToggleButton.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                    <TextBlock x:Name="DetailsToggleLabel" Text="Сведения" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <Rectangle Grid.Row="1" Style="{StaticResource NxDividerStyle}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Column headers (details view)  -->
                <Grid
                    Padding="20,4,28,0"
                    Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsDetailsView), Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" MaxWidth="560" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <Button AutomationProperties.Name="Имя" Click="ColumnHeader_Click" Style="{StaticResource NxColumnHeaderButtonStyle}" Tag="Name">
                        <StackPanel Margin="20,0,0,0" Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="Имя" />
                            <FontIcon FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind SortGlyph(ViewModel.SortField, ViewModel.SortDescending, 0), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Дата изменения" Grid.Column="1" Click="ColumnHeader_Click" Style="{StaticResource NxColumnHeaderButtonStyle}" Tag="Modified">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="Дата изменения" />
                            <FontIcon FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind SortGlyph(ViewModel.SortField, ViewModel.SortDescending, 1), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="{x:Bind ViewModel.ThirdColumnHeader, Mode=OneWay}" Grid.Column="2" Click="ColumnHeader_Click" Style="{StaticResource NxColumnHeaderButtonStyle}" Tag="Type">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="{x:Bind ViewModel.ThirdColumnHeader, Mode=OneWay}" />
                            <FontIcon FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind SortGlyph(ViewModel.SortField, ViewModel.SortDescending, 2), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Размер" Grid.Column="3" Click="ColumnHeader_Click" Style="{StaticResource NxColumnHeaderButtonStyle}" Tag="Size">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="Размер" />
                            <FontIcon FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="{x:Bind SortGlyph(ViewModel.SortField, ViewModel.SortDescending, 3), Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!--  Details view  -->
                <ListView
                    x:Name="FileList"
                    Grid.Row="1"
                    Padding="8,0,8,8"
                    AllowDrop="True"
                    CanDragItems="True"
                    ContainerContentChanging="Items_ContainerContentChanging"
                    ContextRequested="Items_ContextRequested"
                    DoubleTapped="Items_DoubleTapped"
                    DragItemsStarting="Items_DragItemsStarting"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource NxFileRowContainerStyle}"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    SelectionChanged="Items_SelectionChanged"
                    SelectionMode="Extended"
                    Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsDetailsView), Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <Grid
                                Height="{StaticResource NxFileRowHeight}"
                                Background="Transparent"
                                Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="560" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:FileIcon
                                        VerticalAlignment="Center"
                                        IconSize="18"
                                        Kind="{x:Bind Kind}"
                                        Visibility="{x:Bind ui:Ui.Collapsed(HasIcon), Mode=OneWay}" />
                                    <Image
                                        Width="20"
                                        Height="20"
                                        VerticalAlignment="Center"
                                        Source="{x:Bind Icon, Mode=OneWay}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource NxItemTitleTextStyle}"
                                        Text="{x:Bind DisplayName}"
                                        ToolTipService.ToolTip="{x:Bind Name}"
                                        Visibility="{x:Bind ui:Ui.Collapsed(IsRenaming), Mode=OneWay}" />
                                    <TextBox
                                        x:Name="RenameBox"
                                        Grid.Column="1"
                                        MinHeight="28"
                                        Padding="8,3,8,3"
                                        VerticalAlignment="Center"
                                        KeyDown="RenameBox_KeyDown"
                                        LostFocus="RenameBox_LostFocus"
                                        Text="{x:Bind Name}"
                                        Visibility="{x:Bind ui:Ui.Visible(IsRenaming), Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    Padding="13,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource NxBodySecondaryTextStyle}"
                                    Text="{x:Bind DisplayModified}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Padding="13,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource NxBodySecondaryTextStyle}"
                                    Text="{x:Bind TypeOrLocation}"
                                    ToolTipService.ToolTip="{x:Bind TypeOrLocation}" />
                                <TextBlock
                                    Grid.Column="3"
                                    Padding="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource NxBodySecondaryTextStyle}"
                                    Text="{x:Bind DisplaySize}"
                                    TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Large icons view  -->
                <GridView
                    x:Name="FileGrid"
                    Grid.RowSpan="2"
                    Padding="16,12,8,8"
                    AllowDrop="True"
                    CanDragItems="True"
                    ContainerContentChanging="Items_ContainerContentChanging"
                    ContextRequested="Items_ContextRequested"
                    DoubleTapped="Items_DoubleTapped"
                    DragItemsStarting="Items_DragItemsStarting"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    SelectionChanged="Items_SelectionChanged"
                    SelectionMode="Extended"
                    Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsTilesView), Mode=OneWay}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileItemViewModel">
                            <StackPanel
                                Width="120"
                                Padding="8,10,8,8"
                                Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                Spacing="6"
                                ToolTipService.ToolTip="{x:Bind Name}">
                                <Grid Width="96" Height="96">
                                    <controls:FileIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IconSize="64"
                                        Kind="{x:Bind Kind}"
                                        Visibility="{x:Bind ui:Ui.Collapsed(HasLargeImage), Mode=OneWay}" />
                                    <Image
                                        MaxWidth="96"
                                        MaxHeight="96"
                                        Source="{x:Bind LargeImage, Mode=OneWay}"
                                        Stretch="Uniform" />
                                </Grid>
                                <!--  GridView sizes every tile like the first one, so always reserve two lines  -->
                                <TextBlock
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    LineHeight="20"
                                    LineStackingStrategy="BlockLineHeight"
                                    MaxLines="2"
                                    Text="{x:Bind DisplayName}"
                                    TextAlignment="Center"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ui:Ui.Collapsed(IsRenaming), Mode=OneWay}" />
                                <TextBox
                                    x:Name="RenameBox"
                                    KeyDown="RenameBox_KeyDown"
                                    LostFocus="RenameBox_LostFocus"
                                    Text="{x:Bind Name}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind ui:Ui.Visible(IsRenaming), Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <ProgressBar
                    Grid.Row="1"
                    Margin="16,0"
                    VerticalAlignment="Top"
                    IsIndeterminate="True"
                    Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}" />

                <!--  Empty / error state  -->
                <StackPanel
                    Grid.RowSpan="2"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                    <FontIcon
                        FontSize="48"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="{x:Bind ViewModel.EmptyGlyph, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                        TextAlignment="Center" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!--  Details pane  -->
            <Border
                x:Name="DetailsPaneHost"
                Grid.Column="1"
                Width="{StaticResource NxDetailsPaneWidth}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsDetailsPaneOpen), Mode=OneWay}">
                <Grid>
                    <StackPanel
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8"
                        Visibility="{x:Bind ui:Ui.Collapsed(ViewModel.HasSelection), Mode=OneWay}">
                        <FontIcon
                            FontSize="40"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Выберите файл, чтобы увидеть сведения о нём."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ScrollViewer
                        Padding="20,20,20,24"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{x:Bind ui:Ui.Visible(ViewModel.HasSelection), Mode=OneWay}">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <Border
                                    MinHeight="180"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <controls:FileIcon
                                            Margin="0,24"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IconSize="88"
                                            Kind="{x:Bind ViewModel.SelectedKind, Mode=OneWay}"
                                            ShowTile="True"
                                            Visibility="{x:Bind ui:Ui.Visible(ShowIconPreview), Mode=OneWay}" />
                                        <Image
                                            MaxHeight="340"
                                            Margin="12"
                                            Source="{x:Bind PreviewImage, Mode=OneWay}"
                                            Stretch="Uniform" />
                                        <ScrollViewer
                                            MaxHeight="340"
                                            Padding="14,12"
                                            HorizontalScrollBarVisibility="Disabled"
                                            VerticalScrollBarVisibility="Auto"
                                            Visibility="{x:Bind ui:Ui.Visible(HasPreviewText), Mode=OneWay}">
                                            <TextBlock
                                                FontFamily="Cascadia Mono, Consolas"
                                                FontSize="12"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind PreviewText, Mode=OneWay}"
                                                TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource NxSecondaryTextStyle}"
                                    Text="{x:Bind PreviewCaption, Mode=OneWay}"
                                    Visibility="{x:Bind ui:Ui.VisibleIfText(PreviewCaption), Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource SubtitleTextBlockStyle}"
                                    Text="{x:Bind ViewModel.SelectedItem.Name, Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="{x:Bind ViewModel.SelectedItem.TypeName, Mode=OneWay, FallbackValue=''}" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Click="Open_Click"
                                    Content="Открыть"
                                    Style="{StaticResource AccentButtonStyle}" />
                                <Button
                                    Grid.Column="1"
                                    AutomationProperties.Name="Показать в Проводнике"
                                    Click="Explorer_Click"
                                    ToolTipService.ToolTip="Показать в Проводнике">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                                <Button
                                    Grid.Column="2"
                                    AutomationProperties.Name="Свойства"
                                    Click="Properties_Click"
                                    ToolTipService.ToolTip="Свойства (Alt+Enter)">
                                    <FontIcon FontSize="16" Glyph="&#xE946;" />
                                </Button>
                            </Grid>

                            <Rectangle Style="{StaticResource NxDividerStyle}" />

                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource NxGroupHeaderStyle}" Text="Сведения" />
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="Размер" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind SelectedSizeText, Mode=OneWay}" />
                                    <TextBlock Grid.Row="1" Style="{StaticResource NxBodySecondaryTextStyle}" Text="Изменён" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.DisplayModified, Mode=OneWay, FallbackValue=''}" />
                                    <TextBlock Grid.Row="2" Style="{StaticResource NxBodySecondaryTextStyle}" Text="Создан" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.SelectedItem.DisplayCreated, Mode=OneWay, FallbackValue=''}" />
                                    <TextBlock Grid.Row="3" Style="{StaticResource NxBodySecondaryTextStyle}" Text="Расположение" />
                                    <TextBlock
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind ViewModel.SelectedItem.Path, Mode=OneWay, FallbackValue=''}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
