<Page
    x:Class="Nexus.App.Views.AiCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Nexus.App.Models"
    xmlns:ui="using:Nexus.App.Converters"
    Background="Transparent">

    <Page.Resources>
        <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}" />
        <Style x:Key="IconTileStyle" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource NxAccentSoftBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            MaxWidth="1480"
            Padding="{StaticResource NxPagePadding}"
            Spacing="28">

            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource NxPageTitleStyle}" Text="AI-центр" />
                    <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="Локальные модели, проекты с агентами и подключения MCP на этом компьютере" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                            <TextBlock Text="Папки поиска" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE72C;" />
                            <TextBlock Text="Сканировать" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!--  Summary  -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource NxCardStyle}">
                    <StackPanel Spacing="10">
                        <Border HorizontalAlignment="Left" Style="{StaticResource IconTileStyle}">
                            <FontIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xF158;" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.ModelsCount}" />
                            <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="{x:Bind ModelsCaption}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource NxCardStyle}">
                    <StackPanel Spacing="10">
                        <Border HorizontalAlignment="Left" Style="{StaticResource IconTileStyle}">
                            <FontIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE794;" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.ProjectsCount}" />
                            <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="AI-проектов" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource NxCardStyle}">
                    <StackPanel Spacing="10">
                        <Border HorizontalAlignment="Left" Style="{StaticResource IconTileStyle}">
                            <FontIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xEBD2;" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.McpCount}" />
                            <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="MCP-сервера" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource NxCardStyle}">
                    <StackPanel Spacing="10">
                        <Border HorizontalAlignment="Left" Style="{StaticResource IconTileStyle}">
                            <FontIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xEA86;" />
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource StatValueStyle}" Text="{x:Bind ViewModel.SkillsCount}" />
                            <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="Skills" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!--  Models  -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="Локальные модели" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Models}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:AiModelItem">
                            <Border Padding="16,12" Style="{StaticResource NxCardStyle}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTileStyle}">
                                        <FontIcon Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xF158;" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="{x:Bind Details}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Fill="{ThemeResource NxSuccessBrush}"
                                            Visibility="{x:Bind ui:Ui.Visible(IsLoaded)}" />
                                        <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="{x:Bind Status}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="3"
                                        AutomationProperties.Name="Открыть папку модели"
                                        Style="{StaticResource NxSubtleButtonStyle}"
                                        ToolTipService.ToolTip="Открыть папку модели">
                                        <FontIcon FontSize="16" Glyph="&#xE838;" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!--  Projects  -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="AI-проекты" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Projects}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout
                            ItemsStretch="Fill"
                            MinColumnSpacing="12"
                            MinItemHeight="128"
                            MinItemWidth="280"
                            MinRowSpacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:AiProjectItem">
                            <Button
                                Padding="16,14"
                                AutomationProperties.Name="{x:Bind Name}"
                                Style="{StaticResource NxCardButtonStyle}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="32"
                                            Height="32"
                                            Style="{StaticResource IconTileStyle}">
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Glyph="&#xE8B7;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource NxItemTitleTextStyle}"
                                                Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="{x:Bind Kind}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsRepeater Grid.Row="1" ItemsSource="{x:Bind Signals}">
                                        <ItemsRepeater.Layout>
                                            <StackLayout Orientation="Horizontal" Spacing="6" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border
                                                    Padding="8,2"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                    <TextBlock FontSize="12" Text="{x:Bind}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                    <Grid Grid.Row="2" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="{x:Bind Path}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource NxSecondaryTextStyle}"
                                            Text="{x:Bind RelativeModified}" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!--  MCP  -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="MCP-серверы" />
                <Border Padding="0,4" Style="{StaticResource NxCardStyle}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.McpServers}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:McpServerItem">
                                <Grid
                                    Height="52"
                                    Padding="16,0"
                                    ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        FontSize="18"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xEBD2;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="{x:Bind Command}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,3"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource NxAccentSoftBrush}"
                                        CornerRadius="10">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{x:Bind Client}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
