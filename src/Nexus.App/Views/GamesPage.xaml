<Page
    x:Class="Nexus.App.Views.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Nexus.App.Controls"
    xmlns:models="using:Nexus.App.Models"
    xmlns:ui="using:Nexus.App.Converters"
    Background="Transparent">

    <Page.Resources>
        <!--
            Game tiles: selection and keyboard focus draw rings around the cover only, so the
            title and date underneath never look boxed in. The 164×246 cover sits 7 px inside
            the tile; the rings use that margin.
        -->
        <Style x:Key="GameTileContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="CoverOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="CoverOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionRing.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionRing.BorderBrush" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            <Setter Target="CoverOverlay.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <VisualState.Setters>
                                            <Setter Target="SelectionRing.BorderBrush" Value="{ThemeResource AccentFillColorSecondaryBrush}" />
                                            <Setter Target="CoverOverlay.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Target="FocusRing.BorderBrush" Value="{ThemeResource FocusStrokeColorOuterBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <ContentPresenter
                                Margin="7,7,7,0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTransitions="{TemplateBinding ContentTransitions}" />
                            <Border
                                x:Name="CoverOverlay"
                                Width="164"
                                Height="246"
                                Margin="7,7,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                CornerRadius="8"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="SelectionRing"
                                Width="172"
                                Height="254"
                                Margin="3,3,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="Transparent"
                                BorderThickness="2"
                                CornerRadius="11"
                                IsHitTestVisible="False" />
                            <Border
                                x:Name="FocusRing"
                                Width="178"
                                Height="260"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="13"
                                IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Command bar: source filter + library actions  -->
        <Grid Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar
                x:Name="SourceFilter"
                VerticalAlignment="Center"
                SelectionChanged="SourceFilter_SelectionChanged" />
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    AutomationProperties.Name="Добавить папку с играми"
                    Click="AddFolder_Click"
                    Style="{StaticResource NxCommandTextButtonStyle}"
                    ToolTipService.ToolTip="Добавить папку, в которой лежат игры (например, D:\Games)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE8F4;" />
                        <TextBlock Text="Добавить папку" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Обновить библиотеку"
                    Click="Refresh_Click"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Обновить библиотеку">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
                <Button
                    AutomationProperties.Name="Другие команды"
                    Style="{StaticResource NxSubtleButtonStyle}"
                    ToolTipService.ToolTip="Другие команды">
                    <FontIcon FontSize="16" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Opening="MoreMenu_Opening" Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Name="ShowHiddenItem" Click="ShowHidden_Click" Text="Показать скрытые игры">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7B3;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <Rectangle Grid.Row="1" Style="{StaticResource NxDividerStyle}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel
                    MaxWidth="1480"
                    Padding="{StaticResource NxPagePadding}"
                    Spacing="28">

                    <!--  Featured: the most recently played game  -->
                    <Grid
                        Height="260"
                        Background="{x:Bind ui:Ui.Gradient(ViewModel.Featured.PaletteFrom, ViewModel.Featured.PaletteTo), Mode=OneWay, FallbackValue={x:Null}}"
                        CornerRadius="8"
                        Visibility="{x:Bind ui:Ui.Visible(ViewModel.HasFeatured), Mode=OneWay}">
                        <Image
                            VerticalAlignment="Center"
                            Source="{x:Bind ui:Ui.Image(ViewModel.Featured.HeroPath, 1400), Mode=OneWay, FallbackValue={x:Null}}"
                            Stretch="UniformToFill" />
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#E6000000" />
                                    <GradientStop Offset="0.55" Color="#66000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel
                            Margin="32,0"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <TextBlock
                                Foreground="#CCFFFFFF"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="ПРОДОЛЖИТЬ ИГРУ" />
                            <TextBlock
                                Foreground="White"
                                Style="{StaticResource TitleLargeTextBlockStyle}"
                                Text="{x:Bind ViewModel.Featured.Name, Mode=OneWay, FallbackValue=''}" />
                            <TextBlock Foreground="#CCFFFFFF" Text="{x:Bind ViewModel.FeaturedDetails, Mode=OneWay}" />
                            <StackPanel
                                Margin="0,14,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    AutomationProperties.Name="Играть"
                                    MinWidth="140"
                                    Click="PlayFeatured_Click"
                                    IsEnabled="{x:Bind ViewModel.Featured.CanLaunch, Mode=OneWay, FallbackValue=False}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                        <TextBlock Text="Играть" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    AutomationProperties.Name="Открыть папку игры"
                                    Background="#33FFFFFF"
                                    BorderBrush="#40FFFFFF"
                                    Click="OpenFeaturedFolder_Click"
                                    Foreground="White"
                                    ToolTipService.ToolTip="Открыть папку игры">
                                    <FontIcon FontSize="16" Glyph="&#xE838;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Style="{StaticResource NxSectionHeaderStyle}" Text="Библиотека" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource NxBodySecondaryTextStyle}"
                                    Text="{x:Bind ViewModel.CountText, Mode=OneWay}" />
                            </StackPanel>
                            <ProgressRing
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
                        </Grid>

                        <!--  Pulled out by the tile's ring margin so the covers line up with the header  -->
                        <GridView
                            x:Name="GamesGrid"
                            Margin="-7,-7,0,0"
                            ContextRequested="GamesGrid_ContextRequested"
                            DoubleTapped="GamesGrid_DoubleTapped"
                            IsItemClickEnabled="False"
                            ItemContainerStyle="{StaticResource GameTileContainerStyle}"
                            ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}"
                            SelectionMode="Single">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:GameItem">
                                    <StackPanel Width="164" Spacing="8">
                                        <Grid>
                                            <controls:GameCover
                                                Width="164"
                                                Height="246"
                                                DecodeWidth="330"
                                                Game="{x:Bind}" />
                                            <Border
                                                Margin="8"
                                                Padding="8,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{ThemeResource NxCoverScrimBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="White"
                                                    Text="{x:Bind SourceLabel}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Padding="2,0" Spacing="1">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Style="{StaticResource NxItemTitleTextStyle}"
                                                Text="{x:Bind Name}" />
                                            <TextBlock Style="{StaticResource NxSecondaryTextStyle}" Text="{x:Bind DisplayLastPlayed}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!--  Empty library  -->
                        <Border Style="{StaticResource NxCardStyle}" Visibility="{x:Bind ui:Ui.Visible(ViewModel.IsEmpty), Mode=OneWay}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="24"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE7FC;" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="Игры не найдены" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Nexus находит игры Steam, Epic Games, Xbox и GOG сам. Другие игры появятся здесь, если добавить папку, где они лежат."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Click="AddFolder_Click"
                                    Content="Добавить папку" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!--  Details pane  -->
            <Border
                Grid.Column="1"
                Width="{StaticResource NxDetailsPaneWidth}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0"
                Visibility="{x:Bind ui:Ui.Visible(ViewModel.HasSelection), Mode=OneWay}">
                <ScrollViewer Padding="20,20,20,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16">
                        <controls:GameCover
                            Height="240"
                            HorizontalAlignment="Stretch"
                            DecodeWidth="560"
                            Game="{x:Bind ViewModel.SelectedGame, Mode=OneWay}" />
                        <StackPanel Spacing="4">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.SelectedGame.Name, Mode=OneWay, FallbackValue=''}"
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource NxBodySecondaryTextStyle}" Text="{x:Bind ViewModel.SelectedGame.SourceLabel, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                AutomationProperties.Name="Играть"
                                HorizontalAlignment="Stretch"
                                Click="PlaySelected_Click"
                                IsEnabled="{x:Bind ViewModel.SelectedGame.CanLaunch, Mode=OneWay, FallbackValue=False}"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                    <TextBlock Text="Играть" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.Name="Открыть папку игры"
                                Click="OpenSelectedFolder_Click"
                                ToolTipService.ToolTip="Открыть папку игры">
                                <FontIcon FontSize="16" Glyph="&#xE838;" />
                            </Button>
                            <Button
                                Grid.Column="2"
                                AutomationProperties.Name="Другие действия"
                                ToolTipService.ToolTip="Другие действия">
                                <FontIcon FontSize="16" Glyph="&#xE712;" />
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuFlyoutItem Click="ShowInExplorer_Click" Text="Показать в Проводнике">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xEC50;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutItem Click="HideSelected_Click" Text="Скрыть из библиотеки">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xED1A;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <Rectangle Style="{StaticResource NxDividerStyle}" />
                        <StackPanel Spacing="12">
                            <TextBlock Style="{StaticResource NxGroupHeaderStyle}" Text="Сведения" />
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{StaticResource NxBodySecondaryTextStyle}"
                                    Text="Последний запуск"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SelectedGame.DisplayLastPlayed, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource NxBodySecondaryTextStyle}"
                                    Text="Размер" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{x:Bind ViewModel.SelectedGame.DisplaySize, Mode=OneWay, FallbackValue=''}" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource NxBodySecondaryTextStyle}"
                                    Text="Папка" />
                                <TextBlock
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind ViewModel.SelectedGame.InstallPath, Mode=OneWay, FallbackValue=''}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
