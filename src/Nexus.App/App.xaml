<Application
    x:Class="Nexus.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Windows 11 look: the app uses the accent colour chosen in Windows
                and the standard Fluent theme brushes. Only a few helper brushes
                derived from the system accent are added here.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="NxAccentSoftBrush" Opacity="0.16" Color="{ThemeResource SystemAccentColorLight2}" />
                    <SolidColorBrush x:Key="NxTrackBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="NxCoverScrimBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="NxSuccessBrush" Color="#FF6CCB5F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="NxAccentSoftBrush" Opacity="0.12" Color="{ThemeResource SystemAccentColorDark1}" />
                    <SolidColorBrush x:Key="NxTrackBrush" Color="#17000000" />
                    <SolidColorBrush x:Key="NxCoverScrimBrush" Color="#80000000" />
                    <SolidColorBrush x:Key="NxSuccessBrush" Color="#FF0F7B0F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
