                                        Click="SelectAllCommandButton_Click"
                                        Label="Выбрать всё">
                                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B3;" /></AppBarButton.Icon>
                                    </AppBarButton>
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                            <Grid Grid.Row="2" Margin="8">
                                <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid x:Name="ListColumnHeader" Padding="12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition MinWidth="180" Width="2*" />
                                        <ColumnDefinition MinWidth="150" Width="1.1*" />
                                        <ColumnDefinition MinWidth="130" Width="0.9*" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="NameSortHeaderButton"
                                        Grid.Column="1"
                                        Tag="Name"
                                        Padding="0"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ColumnSortButton_Click"
                                        Content="Имя"
                                        FontSize="12"
                                        Foreground="{StaticResource NexusTextTertiaryBrush}"
                                        ToolTipService.ToolTip="Сортировать по имени" />
                                    <Button
                                        x:Name="ModifiedSortHeaderButton"
                                        Grid.Column="2"
                                        Tag="Modified"
                                        Padding="0"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ColumnSortButton_Click"
                                        Content="Изменён"
                                        FontSize="12"
                                        Foreground="{StaticResource NexusTextTertiaryBrush}"
                                        ToolTipService.ToolTip="Сортировать по дате изменения" />
                                    <Button
                                        x:Name="TypeSortHeaderButton"
                                        Grid.Column="3"
                                        Tag="Type"
                                        Padding="0"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ColumnSortButton_Click"
                                        Content="Тип"
                                        FontSize="12"
                                        Foreground="{StaticResource NexusTextTertiaryBrush}"
                                        ToolTipService.ToolTip="Сортировать по типу" />
                                    <Button
                                        x:Name="SizeSortHeaderButton"
                                        Grid.Column="4"
                                        Tag="Size"
                                        Padding="0"
                                        HorizontalContentAlignment="Right"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ColumnSortButton_Click"
                                        Content="Размер"
                                        FontSize="12"
                                        Foreground="{StaticResource NexusTextTertiaryBrush}"
                                        ToolTipService.ToolTip="Сортировать по размеру" />
                                </Grid>
                                <ListView
                                    x:Name="BrowserListView"
                                    Grid.Row="1"
                                    CanDragItems="True"
                                    DragItemsStarting="BrowserItems_DragItemsStarting"
                                    ItemsSource="{x:Bind ViewModel.Items}"
                                    DoubleTapped="BrowserItems_DoubleTapped"
                                    RightTapped="BrowserItems_RightTapped"
                                    SelectionChanged="BrowserItems_SelectionChanged"
                                    SelectionMode="Extended">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="MinHeight" Value="50" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileSystemEntry">
                                            <Grid
                                                Height="48"
                                                Padding="12,0"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                ToolTipService.ToolTip="{x:Bind FullPath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition MinWidth="180" Width="2*" />
                                                    <ColumnDefinition MinWidth="150" Width="1.1*" />
                                                    <ColumnDefinition MinWidth="130" Width="0.9*" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="34" Height="34">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Foreground="{StaticResource NexusAccentBrush}"
                                                        Glyph="{x:Bind IconGlyph}"
                                                        Opacity="1"
                                                        AutomationProperties.AccessibilityView="Raw" />
                                                    <Image
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        ImageFailed="ThumbnailImage_ImageFailed"
                                                        Loaded="ThumbnailImage_Loaded"
                                                        Opacity="0"
                                                        Stretch="Uniform"
                                                        Tag="{Binding}"
                                                        Unloaded="ThumbnailImage_Unloaded" />
                                                </Grid>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTipService.ToolTip="{x:Bind Name}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource NexusTextTertiaryBrush}" Text="{x:Bind DisplayModified}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource NexusTextSecondaryBrush}" Text="{x:Bind DisplayType}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource NexusTextTertiaryBrush}" Text="{x:Bind DisplaySize}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <GridView
                                    x:Name="BrowserGridView"
                                    Grid.RowSpan="2"
                                    Padding="8"
                                    CanDragItems="True"
                                    DragItemsStarting="BrowserItems_DragItemsStarting"
                                    ItemsSource="{x:Bind ViewModel.Items}"
                                    DoubleTapped="BrowserItems_DoubleTapped"
                                    RightTapped="BrowserItems_RightTapped"
                                    SelectionChanged="BrowserItems_SelectionChanged"
                                    SelectionMode="Extended"
                                    Visibility="Collapsed">
                                    <GridView.ItemContainerStyle>
                                        <Style TargetType="GridViewItem">
                                            <Setter Property="Width" Value="158" />
                                            <Setter Property="Height" Value="118" />
                                            <Setter Property="Margin" Value="4" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="CornerRadius" Value="10" />
                                        </Style>
                                    </GridView.ItemContainerStyle>
                                    <GridView.ItemTemplate>
                                        <DataTemplate x:DataType="models:FileSystemEntry">
                                            <Grid
                                                Width="150"
                                                Height="110"
                                                Padding="14"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                ToolTipService.ToolTip="{x:Bind FullPath}">
                                                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <Grid Width="52" Height="52" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <FontIcon
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="30"
                                                        Foreground="{StaticResource NexusAccentBrush}"
                                                        Glyph="{x:Bind IconGlyph}"
                                                        Opacity="1"
                                                        AutomationProperties.AccessibilityView="Raw" />
                                                    <Image
                                                        AutomationProperties.Name="{x:Bind Name}"
                                                        ImageFailed="ThumbnailImage_ImageFailed"
                                                        Loaded="ThumbnailImage_Loaded"
                                                        Opacity="0"
                                                        Stretch="Uniform"
                                                        Tag="{Binding}"
                                                        Unloaded="ThumbnailImage_Unloaded" />
                                                </Grid>
                                                <TextBlock
                                                    Grid.Row="1"
                                                    FontSize="12"
                                                    MaxLines="2"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>
                                <StackPanel x:Name="BrowserEmptyState" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                                    <FontIcon FontSize="34" Foreground="{StaticResource NexusTextTertiaryBrush}" Glyph="&#xE838;" />
                                    <TextBlock x:Name="BrowserEmptyTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="Здесь пока пусто" />
                                    <TextBlock
                                        x:Name="BrowserEmptyDescription"
                                        MaxWidth="420"
                                        HorizontalAlignment="Center"
                                        Text="В этом разделе пока нет файлов и папок."
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        Foreground="{StaticResource NexusTextSecondaryBrush}" />
                                    <Button
                                        x:Name="BrowserEmptyActionButton"
                                        MinWidth="132"
                                        Margin="0,8,0,0"
                                        HorizontalAlignment="Center"
                                        Click="BrowserEmptyActionButton_Click"
                                        Content="Обновить"
                                        CornerRadius="8" />
                                </StackPanel>
                                <ProgressRing x:Name="LoadingIndicator" Grid.RowSpan="2" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <Border
                        x:Name="PreviewPanel"
                        Grid.Column="1"
                        Background="{StaticResource NexusChromeBrush}"
                        BorderBrush="{StaticResource NexusBorderBrush}"
                        BorderThickness="1,0,0,0">
                        <Grid Padding="20,18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid x:Name="PreviewHeader">
                                <TextBlock FontWeight="SemiBold" Text="Сведения" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="ClosePreviewButton_Click"
                                    Style="{StaticResource ChromeIconButtonStyle}"
                                    AutomationProperties.Name="Закрыть панель сведений"
                                    ToolTipService.ToolTip="Закрыть панель сведений">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                            <ScrollViewer Grid.Row="1" Margin="0,22,0,16">
                                <StackPanel>
                                    <Image x:Name="PreviewImage" MaxHeight="210" Margin="0,0,0,18" Stretch="Uniform" Visibility="Collapsed" />
                                    <Border
                                        x:Name="PreviewDocumentCover"
                                        Width="190"
                                        Height="226"
                                        Margin="0,0,0,18"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource NexusRaisedBrush}"
                                        BorderBrush="{StaticResource NexusAccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="Collapsed">
                                        <Grid Padding="20,28,16,14">
                                            <TextBlock
                                                x:Name="PreviewCoverTitle"
                                                MaxHeight="94"
                                                VerticalAlignment="Top"
                                                FontSize="17"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource NexusTextPrimaryBrush}"
                                                Text="Документ"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <Border
                                                Width="48"
                                                Height="48"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom"
                                                Background="{StaticResource NexusSelectedBrush}"
                                                BorderBrush="{StaticResource NexusAccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <TextBlock
                                                    x:Name="PreviewCoverBadge"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="22"
                                                    FontWeight="Bold"
                                                    Foreground="{StaticResource NexusAccentBrush}"
                                                    Text="W" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Border x:Name="PreviewGlyphShell" Width="82" Height="82" HorizontalAlignment="Left" Background="{StaticResource NexusSelectedBrush}" BorderBrush="{StaticResource NexusAccentBrush}" BorderThickness="1" CornerRadius="12">
                                        <FontIcon x:Name="PreviewGlyph" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="38" Foreground="{StaticResource NexusAccentBrush}" Glyph="&#xE8B7;" />
                                    </Border>
                                    <TextBlock
                                        x:Name="PreviewName"
                                        Margin="0,16,0,0"
                                        FontSize="21"
                                        FontWeight="SemiBold"
                                        MaxLines="2"
                                        Text="Nexus Shell"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                    <TextBlock x:Name="PreviewType" Margin="0,6,0,24" FontSize="13" Foreground="{StaticResource NexusTextSecondaryBrush}" Text="Основное пространство" />
                                    <TextBlock
                                        x:Name="PreviewPathLabel"
                                        FontSize="12"
                                        Foreground="{StaticResource NexusTextTertiaryBrush}"
                                        Text="Расположение" />
                                    <TextBlock x:Name="PreviewPath" Margin="0,6,0,18" FontSize="13" Foreground="{StaticResource NexusTextSecondaryBrush}" Text="Работа › Проекты" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PreviewModifiedLabel" FontSize="12" Foreground="{StaticResource NexusTextTertiaryBrush}" Text="Изменён" />
                                    <TextBlock x:Name="PreviewModified" Margin="0,6,0,18" FontSize="13" Foreground="{StaticResource NexusTextSecondaryBrush}" Text="Сейчас" />
                                    <TextBlock x:Name="PreviewSizeLabel" FontSize="12" Foreground="{StaticResource NexusTextTertiaryBrush}" Text="Размер" />
                                    <TextBlock x:Name="PreviewSize" Margin="0,6,0,0" FontSize="13" Foreground="{StaticResource NexusTextSecondaryBrush}" Text="—" />

                                    <Border
                                        x:Name="OrganizationSuggestionPanel"
                                        Margin="0,24,0,0"
                                        Padding="14"
                                        Background="{StaticResource NexusSelectedBrush}"
                                        CornerRadius="10"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon FontSize="15" Foreground="{StaticResource NexusAccentBrush}" Glyph="&#xE945;" />
                                                <TextBlock FontWeight="SemiBold" Text="Nexus предлагает" />
                                            </StackPanel>
                                            <TextBlock x:Name="SuggestedDestination" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SuggestedReason" FontSize="12" Foreground="{StaticResource NexusTextSecondaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock x:Name="SuggestedConfidence" FontSize="11" Foreground="{StaticResource NexusTextTertiaryBrush}" />
                                            <Button
                                                x:Name="ApplySuggestionButton"
                                                MinHeight="36"
                                                Click="ApplySuggestionButton_Click"
                                                Content="Применить"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Grid.Row="2" Spacing="8">
                                <Button
                                    x:Name="UndoSuggestionButton"
                                    MinHeight="38"
                                    Click="UndoSuggestionButton_Click"
                                    Content="Отменить последнее перемещение"
                                    CornerRadius="8"
                                    Visibility="Collapsed" />
                                <Button x:Name="OpenPreviewButton" HorizontalAlignment="Stretch" Click="OpenPreviewButton_Click" Content="Открыть" Style="{StaticResource PrimaryButtonStyle}" />
                                <StackPanel
                                    x:Name="GameManagementPanel"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <Button
                                        MinHeight="40"
                                        Click="OpenSelectedGameFilesButton_Click"
                                        Content="Файлы в Nexus"
                                        CornerRadius="8" />
                                    <Button
                                        x:Name="DeleteGameFilesButton"
                                        MinHeight="40"
                                        Click="DeleteOrManageGameButton_Click"
                                        Content="Удалить файлы…"
                                        CornerRadius="8" />
                                    <Button
                                        MinHeight="40"
                                        Click="HideSelectedGameButton_Click"
                                        Content="Скрыть из библиотеки"
                                        CornerRadius="8" />
                                </StackPanel>
                                <StackPanel
                                    x:Name="RecycleBinManagementPanel"
                                    Spacing="8"
                                    Visibility="Collapsed">
                                    <Button
                                        MinHeight="40"
                                        Click="RestoreRecycleBinCommandButton_Click"
                                        Content="Восстановить"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                    <Button
                                        MinHeight="40"
                                        Click="DeleteRecycleBinCommandButton_Click"
                                        Content="Удалить безвозвратно…"
                                        Foreground="#FFFF8080"
                                        CornerRadius="8" />
                                </StackPanel>
                                <Grid
                                    x:Name="PreviewFileActions"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" MinHeight="40" Click="CopyPathButton_Click" Content="Копировать путь" CornerRadius="8" />
                                    <Button x:Name="PreviewOpenInExplorerButton" Grid.Column="1" MinHeight="40" Click="OpenInExplorerButton_Click" Content="Проводник" CornerRadius="8" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Padding="14,0" BorderBrush="{StaticResource NexusBorderBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid MinWidth="0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="StatusTextBlock"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource NexusTextTertiaryBrush}"
                                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                AutomationProperties.LiveSetting="Polite" />
                            <TextBlock
                                x:Name="SelectionStatusTextBlock"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NexusAccentBrush}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="Collapsed" />
                        </Grid>
                        <StackPanel
                            x:Name="OperationProgressPanel"
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10"
                            Visibility="Collapsed">
                            <StackPanel
                                Width="210"
                                VerticalAlignment="Center"
                                Spacing="3">
                                <TextBlock
                                    x:Name="OperationProgressTextBlock"
                                    FontSize="11"
                                    Foreground="{StaticResource NexusTextSecondaryBrush}"
                                    Text="Подготовка операции…"
                                    TextAlignment="Right"
                                    TextTrimming="CharacterEllipsis" />
                                <ProgressBar
                                    x:Name="OperationProgressBar"
                                    Width="210"
                                    Height="4"
                                    IsIndeterminate="True"
                                    Maximum="100"
                                    AutomationProperties.Name="Ход файловой операции" />
                            </StackPanel>
                            <Button
                                x:Name="PauseFileOperationButton"
                                MinWidth="94"
                                Height="40"
                                Padding="10,0"
                                Click="PauseFileOperationButton_Click"
                                Content="Пауза"
                                CornerRadius="6" />
                            <Button
                                x:Name="CancelFileOperationButton"
                                MinWidth="86"
                                Height="40"
                                Padding="10,0"
                                Click="CancelFileOperationButton_Click"
                                Content="Отменить"
                                CornerRadius="6" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
