<Window
    x:Class="Nexus.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nexus.App"
    xmlns:models="using:Nexus.Core.Models"
    Title="Nexus Shell">

    <Grid
        x:Name="RootGrid"
        Background="{StaticResource NexusCanvasBrush}"
        SizeChanged="RootGrid_SizeChanged">

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator_Invoked" />
            <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator_Invoked" />
            <KeyboardAccelerator Key="Up" Modifiers="Menu" Invoked="UpAccelerator_Invoked" />
            <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator_Invoked" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="CloseTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control" Invoked="NextTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="Tab" Modifiers="Control,Shift" Invoked="PreviousTabAccelerator_Invoked" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="SearchAccelerator_Invoked" />
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="AddressAccelerator_Invoked" />
            <KeyboardAccelerator Key="A" Modifiers="Control" Invoked="SelectAllAccelerator_Invoked" />
            <KeyboardAccelerator Key="C" Modifiers="Control" Invoked="CopyAccelerator_Invoked" />
            <KeyboardAccelerator Key="X" Modifiers="Control" Invoked="CutAccelerator_Invoked" />
            <KeyboardAccelerator Key="V" Modifiers="Control" Invoked="PasteAccelerator_Invoked" />
            <KeyboardAccelerator Key="F2" Invoked="RenameAccelerator_Invoked" />
            <KeyboardAccelerator Key="Delete" Invoked="DeleteAccelerator_Invoked" />
            <KeyboardAccelerator Key="N" Modifiers="Control,Shift" Invoked="NewFolderAccelerator_Invoked" />
            <KeyboardAccelerator Key="Enter" Invoked="OpenAccelerator_Invoked" />
            <KeyboardAccelerator Key="Enter" Modifiers="Menu" Invoked="PropertiesAccelerator_Invoked" />
            <KeyboardAccelerator Key="Back" Invoked="BackspaceAccelerator_Invoked" />
            <KeyboardAccelerator Key="F10" Modifiers="Shift" Invoked="ContextMenuAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="0,0,142,0"
            Background="{StaticResource NexusChromeBrush}"
            BorderBrush="{StaticResource NexusBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleSidebarColumn" Width="228" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Margin="18,0,0,0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border
                    Width="26"
                    Height="26"
                    Background="{StaticResource NexusSelectedBrush}"
                    CornerRadius="8">
                    <Image
                        Margin="1"
                        Source="Assets/Nexus.png"
                        Stretch="UniformToFill" />
                </Border>
                <TextBlock
                    x:Name="AppTitleText"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Nexus Shell" />
            </StackPanel>

            <Button
                x:Name="HomeTabButton"
                Grid.Column="1"
                MinWidth="156"
                Height="42"
                Margin="6,6,0,6"
                Padding="14,0"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="10"
                Click="HomeTabButton_Click"
                AutomationProperties.Name="Главная вкладка">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon FontSize="15" Glyph="&#xE80F;" />
                    <TextBlock x:Name="HomeTabLabel" VerticalAlignment="Center" Text="Главная" />
                </StackPanel>
            </Button>

            <Button
                x:Name="DashboardTabButton"
                Grid.Column="2"
                MinWidth="206"
                Height="46"
                Margin="6,5,0,3"
                Padding="14,0"
                Background="{StaticResource NexusRaisedBrush}"
                BorderThickness="0"
                Click="DashboardTabButton_Click"
                CornerRadius="12,12,0,0"
                AutomationProperties.Name="Вкладка Проекты">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        x:Name="DashboardTabIcon"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource NexusAccentBrush}"
                        Glyph="&#xE8B7;" />
                    <TextBlock
                        x:Name="DashboardTabLabel"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Проекты" />
                </Grid>
            </Button>

            <ScrollViewer
                x:Name="WorkspaceTabsScroller"
                Grid.Column="3"
                MaxWidth="620"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <StackPanel
                    x:Name="WorkspaceTabStrip"
                    Height="46"
                    Margin="6,5,0,3"
                    Orientation="Horizontal"
                    Spacing="6" />
            </ScrollViewer>

            <Button
                Grid.Column="4"
                Width="42"
                Height="42"
                Margin="6"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="8"
                Click="NewTabButton_Click"
                AutomationProperties.Name="Новая вкладка"
                ToolTipService.ToolTip="Новая вкладка">
                <FontIcon FontSize="16" Glyph="&#xE710;" />
            </Button>

            <Grid
                x:Name="TitleBarDragRegion"
                Grid.Column="5"
                Background="Transparent" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="228" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{StaticResource NexusChromeBrush}"
                BorderBrush="{StaticResource NexusBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid Padding="10,12,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer
                        x:Name="NavigationScrollViewer"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2">
                            <Button
                                x:Name="HomeNavigationButton"
                                Tag="home"
                                Click="NavigationButton_Click"
                                Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE80F;" />
                                    <TextBlock x:Name="HomeNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Главная" />
                                </Grid>
                            </Button>
                            <Button
                                x:Name="RecentNavigationButton"
                                Tag="recent"
                                Click="NavigationButton_Click"
                                Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE823;" />
                                    <TextBlock x:Name="RecentNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Последние" />
                                </Grid>
                            </Button>
                            <Button
                                x:Name="FavoritesNavigationButton"
                                Tag="favorites"
                                Click="NavigationButton_Click"
                                Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE734;" />
                                    <TextBlock x:Name="FavoritesNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Избранное" />
                                </Grid>
                            </Button>
                            <Button
                                x:Name="InboxNavigationButton"
                                Tag="inbox"
                                Click="NavigationButton_Click"
                                Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE715;" />
                                    <TextBlock x:Name="InboxNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Входящие" />
                                </Grid>
                            </Button>

                            <TextBlock
                                x:Name="SpacesNavigationHeader"
                                Margin="12,18,0,7"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NexusTextTertiaryBrush}"
                                Text="ПРОСТРАНСТВА" />

                            <Button x:Name="WorkNavigationButton" Tag="work" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE821;" />
                                    <TextBlock x:Name="WorkNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Работа" />
                                </Grid>
                            </Button>
                            <Button x:Name="ProjectsNavigationButton" Tag="projects" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                    <TextBlock x:Name="ProjectsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Проекты" />
                                </Grid>
                            </Button>
                            <Button x:Name="PersonalNavigationButton" Tag="personal" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE77B;" />
                                    <TextBlock x:Name="PersonalNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Личное" />
                                </Grid>
                            </Button>
                            <Button x:Name="MediaNavigationButton" Tag="media" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8B2;" />
                                    <TextBlock x:Name="MediaNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Медиа" />
                                </Grid>
                            </Button>
                            <Button x:Name="GamesNavigationButton" Tag="games" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE7FC;" />
                                    <TextBlock x:Name="GamesNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Игры" />
                                </Grid>
                            </Button>
                            <Button x:Name="ApplicationsNavigationButton" Tag="applications" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xECAA;" />
                                    <TextBlock x:Name="ApplicationsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Приложения" />
                                </Grid>
                            </Button>
                            <Button x:Name="TorrentsNavigationButton" Tag="torrents" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                                    <TextBlock x:Name="TorrentsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Торренты" />
                                </Grid>
                            </Button>
                            <Button x:Name="ArchiveNavigationButton" Tag="archive" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE7B8;" />
                                    <TextBlock x:Name="ArchiveNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Архив" />
                                </Grid>
                            </Button>

                            <TextBlock
                                x:Name="StorageNavigationHeader"
                                Margin="12,18,0,7"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NexusTextTertiaryBrush}"
                                Text="ХРАНИЛИЩА" />

                            <Button x:Name="ComputerNavigationButton" Tag="computer" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE7F8;" />
                                    <TextBlock x:Name="ComputerNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Этот компьютер" />
                                </Grid>
                            </Button>
                            <Button x:Name="NetworkNavigationButton" Tag="network" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE968;" />
                                    <TextBlock x:Name="NetworkNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Сеть" />
                                </Grid>
                            </Button>
                            <Button x:Name="DocumentsNavigationButton" Tag="documents" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8A5;" />
                                    <TextBlock x:Name="DocumentsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Документы" />
                                </Grid>
                            </Button>
                            <Button x:Name="DownloadsNavigationButton" Tag="downloads" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE896;" />
                                    <TextBlock x:Name="DownloadsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Загрузки" />
                                </Grid>
                            </Button>
                            <Button x:Name="DesktopNavigationButton" Tag="desktop" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8FC;" />
                                    <TextBlock x:Name="DesktopNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Рабочий стол" />
                                </Grid>
                            </Button>
                            <Button x:Name="PicturesNavigationButton" Tag="pictures" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xEB9F;" />
                                    <TextBlock x:Name="PicturesNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Изображения" />
                                </Grid>
                            </Button>
                            <Button x:Name="VideosNavigationButton" Tag="videos" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE714;" />
                                    <TextBlock x:Name="VideosNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Видео" />
                                </Grid>
                            </Button>
                            <Button x:Name="MusicNavigationButton" Tag="music" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8D6;" />
                                    <TextBlock x:Name="MusicNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Музыка" />
                                </Grid>
                            </Button>
                            <Button x:Name="RecycleNavigationButton" Click="RecycleNavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                    <TextBlock x:Name="RecycleNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Корзина" />
                                </Grid>
                            </Button>

                            <Border
                                x:Name="AiNavigationSeparator"
                                Height="1"
                                Margin="8,14,8,8"
                                Background="{StaticResource NexusBorderBrush}" />

                            <TextBlock
                                x:Name="AiNavigationHeader"
                                Margin="12,6,0,7"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource NexusTextTertiaryBrush}"
                                Text="AI-ЦЕНТР" />

                            <Button x:Name="AiCenterNavigationButton" Tag="ai-center" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE945;" />
                                    <TextBlock x:Name="AiCenterNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="AI-центр" />
                                </Grid>
                            </Button>
                            <Button x:Name="ModelsNavigationButton" Tag="models" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xF158;" />
                                    <TextBlock x:Name="ModelsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Модели" />
                                </Grid>
                            </Button>
                            <Button x:Name="AiProjectsNavigationButton" Tag="ai-projects" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                    <TextBlock x:Name="AiProjectsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="AI-проекты" />
                                </Grid>
                            </Button>
                            <Button x:Name="SkillsNavigationButton" Tag="skills" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE945;" />
                                    <TextBlock x:Name="SkillsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Skills" />
                                </Grid>
                            </Button>
                            <Button x:Name="McpNavigationButton" Tag="mcp" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8A9;" />
                                    <TextBlock x:Name="McpNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="MCP" />
                                </Grid>
                            </Button>
                            <Button x:Name="PromptsNavigationButton" Tag="prompts" Click="NavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon FontSize="16" Glyph="&#xE8A5;" />
                                    <TextBlock x:Name="PromptsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Промты" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Spacing="2">
                        <Button x:Name="SettingsNavigationButton" Click="SettingsNavigationButton_Click" Style="{StaticResource NavigationButtonStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon FontSize="16" Glyph="&#xE713;" />
                                <TextBlock x:Name="SettingsNavigationLabel" Grid.Column="1" VerticalAlignment="Center" Text="Настройки" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="ExplorerFallbackButton"
                            Click="ExplorerFallbackButton_Click"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTipService.ToolTip="Аварийный запуск стандартного Проводника">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon FontSize="16" Glyph="&#xE838;" />
                                <TextBlock x:Name="ExplorerFallbackLabel" Grid.Column="1" VerticalAlignment="Center" Text="Проводник" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="44" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="16,0"
                    BorderBrush="{StaticResource NexusBorderBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="SearchColumn" Width="300" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BackButton"
                            Grid.Column="0"
                            Click="BackButton_Click"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            AutomationProperties.Name="Назад"
                            ToolTipService.ToolTip="Назад (Alt+←)">
                            <FontIcon FontSize="15" Glyph="&#xE72B;" />
                        </Button>
                        <Button
                            x:Name="ForwardButton"
                            Grid.Column="1"
                            Click="ForwardButton_Click"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            AutomationProperties.Name="Вперёд"
                            ToolTipService.ToolTip="Вперёд (Alt+→)">
                            <FontIcon FontSize="15" Glyph="&#xE72A;" />
                        </Button>
                        <Button
                            x:Name="UpButton"
                            Grid.Column="2"
                            Click="UpButton_Click"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            AutomationProperties.Name="На уровень выше"
                            ToolTipService.ToolTip="На уровень выше (Alt+↑)">
                            <FontIcon FontSize="15" Glyph="&#xE74A;" />
                        </Button>
                        <TextBox
                            x:Name="AddressBox"
                            Grid.Column="3"
                            Height="38"
                            VerticalAlignment="Center"
                            Padding="12,0"
                            Background="{StaticResource NexusInsetBrush}"
                            BorderBrush="{StaticResource NexusBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            KeyDown="AddressBox_KeyDown"
                            PlaceholderText="Введите путь к папке"
                            ToolTipService.ToolTip="Адрес папки · Ctrl+L" />
                        <TextBox
                            x:Name="SearchBox"
                            Grid.Column="4"
                            Height="38"
                            VerticalAlignment="Center"
                            Background="{StaticResource NexusInsetBrush}"
                            BorderBrush="{StaticResource NexusBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            KeyDown="SearchBox_KeyDown"
                            PlaceholderText="Поиск"
                            TextChanged="SearchBox_TextChanged"
                            ToolTipService.ToolTip="Введите запрос; Enter ищет во всех вложенных папках" />
                        <Button
                            x:Name="RefreshButton"
                            Grid.Column="5"
                            Click="RefreshButton_Click"
                            Style="{StaticResource ChromeIconButtonStyle}"
                            AutomationProperties.Name="Обновить"
                            ToolTipService.ToolTip="Обновить (F5)">
                            <FontIcon FontSize="15" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="ErrorInfoBar"
                    Grid.Row="1"
                    Margin="16,8,16,0"
                    CloseButtonClick="ErrorInfoBar_CloseButtonClick"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Error"
                    Title="Операция не выполнена" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="320" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ScrollViewer
                            x:Name="HomeView"
                            Padding="24,16,24,28"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                x:Name="HomeContentPanel"
                                MaxWidth="1360"
                                Spacing="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
